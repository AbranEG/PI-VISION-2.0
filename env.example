# --- IA ---
USE_TPU=false
FACE_MATCH_THRESHOLD=0.45
GESTURE_DETECTION_CONFIDENCE=0.7
DETECTION_FRAME_SKIP=2

# --- Eventos (Fase 1) ---
MOTION_MIN_AREA_PCT=0.5        # % del cuadro que debe cambiar para contar como movimiento
MOTION_EVENT_INTERVAL=5        # segundos entre eventos de movimiento guardados
FACE_EVENT_INTERVAL=10         # segundos entre eventos de la misma persona
COUNT_EVENT_INTERVAL=2         # segundos mínimos entre cambios de conteo
EVENT_RETENTION_DAYS=90        # días que se conservan los eventos (los heredados nunca se borran)

# --- Fotos de eventos (Fase 2) ---
EVENT_SNAPSHOTS=all            # all = foto en cada evento · gesture = solo gestos · none = sin fotos
EVENT_JPEG_QUALITY=80          # calidad JPEG (≈30 KB por foto a 640x480)

# --- Flask ---
SECRET_KEY=

# --- Correo (contraseña de aplicación de Gmail NUEVA) ---
EMAIL_SERVER=smtp.gmail.com
EMAIL_PORT=465
EMAIL_FROM=pivision.alerts@gmail.com
EMAIL_PASSWORD=
EMAIL_TO=luisfernandorc16@gmail.com

# --- Telegram (token NUEVO de @BotFather) ---
TELEGRAM_BOT_TOKEN=

# --- Objetos con el Hailo (Fase 3) ---
OBJECT_DETECTION=true          # false = no usar el servicio Hailo
# "person" no genera eventos de objeto: alimenta el conteo y el seguimiento de personas
OBJECT_CLASSES=person,car,motorcycle,backpack,dog,cell phone   # nombres COCO en inglés (80 disponibles)
COUNT_STABLE_S=1.0             # ventana (s) para suavizar el conteo de personas
OBJECT_MIN_SCORE=0.5           # confianza mínima general
OBJECT_MIN_SCORES=backpack:0.35,cell phone:0.55   # umbral por clase (medido en la Pi el 31-oct)
OBJECT_PERSIST_N=5             # un objeto cuenta si aparece en K de los últimos N cuadros
OBJECT_PERSIST_K=3
OBJECT_DETECT_EVERY=1          # 1 = cada frame, 2 = uno sí y uno no…
OBJECT_EVENT_INTERVAL=10       # segundos entre eventos de la misma clase
HAILO_SOCKET=/tmp/pivision-hailo.sock

# --- Gestos con pose en el Hailo (Fase 5) ---
POSE_GESTURES=true             # false = gestos con Holistic (CPU), como el sistema original
POSE_MIN_SCORE=0.5             # confianza mínima de la persona
POSE_MIN_VIS=0.5               # visibilidad mínima de hombros y muñecas para aceptar un gesto
GESTURE_COOLDOWN=1.0           # segundos entre gestos (igual que el original)
HAILO_POSE_HEF=/usr/share/hailo-models/yolov8s_pose_h8.hef

# --- Optimización (Fase 5) ---
FACE_REENCODE_S=1.0            # segundos mínimos entre embeddings de las mismas caras
FLASK_DEBUG=false              # true solo para depurar en red local; nunca con ngrok
